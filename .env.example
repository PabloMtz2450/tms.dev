DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tms_dev"
APP_URL="http://localhost:3000"
APP_ENV="development"

# Infraestructura. Sólo habilitar si un proxy/load balancer confiable reescribe estos headers.
TRUST_PROXY_HEADERS="false"

# PAC Finkok. Usar demo durante integración; nunca versionar credenciales reales.
FINKOK_ENV="demo"
FINKOK_USERNAME=""
FINKOK_PASSWORD=""
FINKOK_TIMEOUT_MS="30000"

# CSD / secretos productivos. Los valores reales deben provenir del Secret Manager/KMS del entorno.
CSD_SECRET_PROVIDER=""
CSD_KMS_KEY_ID=""

# Almacenamiento fiscal privado (XML/PDF/POD). Nunca usar bucket/contenedor público.
FISCAL_STORAGE_PROVIDER=""
FISCAL_STORAGE_BUCKET=""
