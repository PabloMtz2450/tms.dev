generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  PLANNER
  DISPATCHER
  DRIVER
  FINANCE
  AUDITOR
  VIEWER
}

enum ShipmentStatus {
  DRAFT
  READY
  PLANNED
  LOADED
  IN_TRANSIT
  DELIVERED
  PARTIAL
  REJECTED
  RETURNED
  CANCELLED
}

enum RouteStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  memberships Membership[]
  customers   Customer[]
  vehicles    Vehicle[]
  drivers     Driver[]
  shipments   Shipment[]
  routes      Route[]
  createdAt   DateTime     @default(now())
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  memberships Membership[]
  createdAt   DateTime     @default(now())
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  organization   Organization   @relation(fields: [organizationId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  @@unique([organizationId, userId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id])
  shipments      Shipment[]
  @@unique([organizationId, code])
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  plate          String
  label          String
  organization   Organization @relation(fields: [organizationId], references: [id])
  routes         Route[]
  @@unique([organizationId, plate])
}

model Driver {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id])
  routes         Route[]
}

model Shipment {
  id             String         @id @default(cuid())
  organizationId String
  customerId     String
  reference      String
  status         ShipmentStatus @default(DRAFT)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  stops          Stop[]
  createdAt      DateTime       @default(now())
  @@unique([organizationId, reference])
}

model Route {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  status         RouteStatus  @default(DRAFT)
  vehicleId      String?
  driverId       String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])
  driver         Driver?      @relation(fields: [driverId], references: [id])
  stops          Stop[]
  createdAt      DateTime     @default(now())
  @@unique([organizationId, code])
}

model Stop {
  id         String   @id @default(cuid())
  routeId    String?
  shipmentId String
  sequence   Int?
  address    String
  route      Route?   @relation(fields: [routeId], references: [id])
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
}
