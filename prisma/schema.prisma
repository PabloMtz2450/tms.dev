generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  PLANNER
  DISPATCHER
  DRIVER
  FINANCE
  AUDITOR
  VIEWER
}

enum ShipmentStatus {
  DRAFT
  READY
  PLANNED
  LOADED
  IN_TRANSIT
  DELIVERED
  PARTIAL
  REJECTED
  RETURNED
  CANCELLED
}

enum RouteStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FiscalDocumentStatus {
  DRAFT
  VALIDATED
  SIGNING
  SIGNED
  STAMPING
  STAMPED
  RECOVERY_REQUIRED
  CANCEL_PENDING
  CANCELLED
  FAILED
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  memberships     Membership[]
  customers       Customer[]
  vehicles        Vehicle[]
  drivers         Driver[]
  shipments       Shipment[]
  routes          Route[]
  sessions        Session[]
  fiscalDocuments FiscalDocument[]
  auditEvents     AuditEvent[]
  createdAt       DateTime         @default(now())
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  memberships Membership[]
  sessions    Session[]
  createdAt   DateTime     @default(now())
}

model Session {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipments      Shipment[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, name])
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  plate          String
  label          String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routes         Route[]

  @@unique([organizationId, plate])
  @@unique([organizationId, id])
  @@index([organizationId, label])
}

model Driver {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routes         Route[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
}

model Shipment {
  id             String         @id @default(cuid())
  organizationId String
  customerId     String
  reference      String
  status         ShipmentStatus @default(DRAFT)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [organizationId, customerId], references: [organizationId, id])
  stops          Stop[]
  createdAt      DateTime       @default(now())

  @@unique([organizationId, reference])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
}

model Route {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  status         RouteStatus  @default(DRAFT)
  vehicleId      String?
  driverId       String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?     @relation(fields: [organizationId, vehicleId], references: [organizationId, id])
  driver         Driver?      @relation(fields: [organizationId, driverId], references: [organizationId, id])
  stops          Stop[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, vehicleId])
  @@index([organizationId, driverId])
}

model Stop {
  id             String   @id @default(cuid())
  organizationId String
  routeId        String?
  shipmentId     String
  sequence       Int?
  address        String
  route          Route?   @relation(fields: [organizationId, routeId], references: [organizationId, id])
  shipment       Shipment @relation(fields: [organizationId, shipmentId], references: [organizationId, id])

  @@index([organizationId, routeId, sequence])
  @@index([organizationId, shipmentId])
}

model FiscalDocument {
  id                  String               @id @default(cuid())
  organizationId      String
  idempotencyKey      String
  documentType        String
  status              FiscalDocumentStatus @default(DRAFT)
  sourceFingerprint   String?
  unsignedXmlHash     String?
  signedXmlHash       String?
  stampedXmlHash      String?
  uuid                String?
  finkokWorkProcessId String?
  lastErrorCode       String?
  lastErrorMessage    String?
  recoveryAttempts    Int                  @default(0)
  xmlObjectKey        String?
  pdfObjectKey        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stampedAt           DateTime?
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, uuid])
  @@index([organizationId, status, updatedAt])
  @@index([sourceFingerprint])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  resourceType   String
  resourceId     String
  occurredAt     DateTime     @default(now())
  previousHash   String?
  eventHash      String
  metadata       Json
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, resourceType, resourceId, occurredAt])
  @@index([actorId, occurredAt])
}
